@'
# Dependencies
**/node_modules/

# Next.js
frontend/.next/
frontend/out/

# Build and test output
**/dist/
**/coverage/

# Environment files
**/.env
**/.env.*
!**/.env.example

# Deployment and tooling
**/.vercel/
**/.turbo/

# Logs
*.log
npm-debug.log*

# Operating system
.DS_Store
Thumbs.db
'@ | Set-Content -Path .gitignore -Encoding utf8